---
import BoltIcon from "@/components/icons/BoltIcon.astro";
import Galaxy from "@/components/Galaxy.astro";
import GlassSurface from "@/components/GlassSurface.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Mateus Reis | Full Stack Dev</title>

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Aclonica&family=Space+Grotesk:wght@300..700&display=swap"
            rel="stylesheet"
        />
    </head>

    <body class="font-sans bg-neutral-950">
        <Galaxy
            density={5}
            hueShift={100}
            glowIntensity={0.1}
            speed={0.1}
            rotationSpeed={0.1}
            mouseRepulsion={false}
            class="fixed inset-0 z-0 pointer-events-none"
        />
        <nav
            class="fixed top-0 left-0 right-0 max-h-20 w-full px-4 py-4 inset-0 z-50"
        >
            <div class="max-w-7xl mx-auto">
                <div
                    class="relative flex items-center justify-between gap-2 lg:gap-12 shadow-xl ring ring-white/10 backdrop-blur-sm pr-4 pl-6 py-5 lg:py-4 rounded-full"
                >
                    <a href="/" class="flex items-center">
                        <BoltIcon fill="fill-primary-300" />

                        <span
                            class="font-bold text-2xl font-display text-neutral-50"
                            >Mateus Reis</span
                        >
                    </a>
                    <div class="hidden sm:block space-x-3">
                        <a
                            href="/about"
                            class="rounded-full font-medium border border-neutral-800 text-neutral-50 px-3 py-2 hover:ring-2 ring-primary-300 transition-all ease-in-out"
                            >Work</a
                        >

                        <a
                            href="https://www.linkedin.com/in/mateuskonige/"
                            target="_blank"
                            class="rounded-full font-medium bg-primary-300 px-3 py-2 hover:ring-2 ring-secondary-900 transition-all ease-in-out"
                            >Get in touch!</a
                        >
                        <!-- botoes -->
                    </div>
                    <div class="sm:hidden">
                        <a
                            href="https://www.linkedin.com/in/mateuskonige/"
                            target="_blank"
                            class="text-xs font-display lg:text-base rounded-full font-medium bg-primary-300 px-3 py-2 -ml-4"
                            >!</a
                        >
                    </div>
                </div>
            </div>
        </nav>

        <slot />

        <footer class="relative p-6 text-slate-50">
            <div
                class="container max-w-7xl mx-auto space-y-6 md:space-y-0 gap-6 block md:flex items-center justify-between relative"
            >
                <div class="block md:flex items-center">
                    <BoltIcon fill="fill-primary-300" />
                </div>

                <div>
                    <p class="text-right" title="Did you find Rocky? :D">
                        Made with ❤️ by <span class="font-display"
                            >Mateus Reis</span
                        >
                    </p>
                    <p class="text-[9px] text-right text-neutral-500">
                        Design inspirations <a
                            href="https://www.behance.net/gallery/168253091/CV-2023"
                            target="_blank"
                            class="font-display">Hannnb</a
                        >, Component inspirations <a
                            href="https://www.reactbits.dev/"
                            target="_blank"
                            class="font-display">Reactbits</a
                        >
                    </p>
                </div>
            </div>
        </footer>
    </body>

    <script>
        import Lenis from "lenis";

        const lenis = new Lenis({
            duration: 1,
            easing: (t) => 1 - Math.pow(1 - t, 3),
            smoothWheel: true,
        });

        function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
    </script>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
